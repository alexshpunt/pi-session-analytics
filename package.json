{
	"name": "pi-session-analytics",
	"version": "0.1.3",
	"description": "Compact offline analytics for ordered Pi tool activity",
	"keywords": [
		"analytics",
		"pi",
		"pi-package",
		"sqlite",
		"tool-use"
	],
	"homepage": "https://github.com/alexshpunt/pi-session-analytics#readme",
	"bugs": {
		"url": "https://github.com/alexshpunt/pi-session-analytics/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexshpunt/pi-session-analytics.git"
	},
	"bin": {
		"pi-session-analytics": "./dist/index.js"
	},
	"files": [
		"dist",
		".agents/skills/pi-session-analytics/SKILL.md",
		".agents/skills/session-friction-insights/SKILL.md",
		".agents/skills/session-friction-insights/scripts/analyze.py"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/api.d.ts",
			"import": "./dist/api.js"
		}
	},
	"scripts": {
		"build": "vp pack && cp src/schema.sql dist/schema.sql",
		"dev": "vp pack --watch",
		"start": "node ./dist/index.js",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"format": "vp check --fix",
		"test": "vp test",
		"test:watch": "vp test watch",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"dependencies": {
		"citty": "^0.2.2",
		"tinyglobby": "^0.2.16"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@types/node": "^25.9.0",
		"typescript": "^7.0.0",
		"vite-plus": "^0.3.0",
		"vitest": "^4.1.6"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@11.24.0",
	"pi": {
		"skills": [
			"./.agents/skills/pi-session-analytics",
			"./.agents/skills/session-friction-insights"
		]
	}
}
